+    #[test]
+    fn quarantine_after_dispatch_retirement_does_not_leak_before_receipt_bd_in31y() {
+        let _leases = QUARANTINED_MOUNT_LEASE_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let retirement = Arc::new(MountJoinRetirement::default());
+        let ops: Arc<dyn FsOps> = Arc::new(MinimalTestFs);
+        let weak = Arc::downgrade(&ops);
+        let retired = Arc::new(std::sync::Barrier::new(2));
+        let send_receipt = Arc::new(std::sync::Barrier::new(2));
+        let (receipt_tx, receipt_rx) = std::sync::mpsc::channel();
+
+        std::thread::scope(|scope| {
+            let worker_retirement = Arc::clone(&retirement);
+            let worker_retired = Arc::clone(&retired);
+            let worker_send_receipt = Arc::clone(&send_receipt);
+            scope.spawn(move || {
+                // The dispatch has joined, but its completion receipt has not
+                // reached the timeout owner yet. The old AtomicU64 handshake
+                // observed lease_id == 0 here and never looked again.
+                worker_retirement.retire();
+                worker_retired.wait();
+                worker_send_receipt.wait();
+                receipt_tx.send(()).expect("send completion receipt");
+            });
+
+            retired.wait();
+            retirement.quarantine(ops);
+            let no_receipt = matches!(
+                receipt_rx.try_recv(),
+                Err(std::sync::mpsc::TryRecvError::Empty)
+            );
+            let authority_released = weak.upgrade().is_none();
+            // Always release the worker before assertions so a regression
+            // fails promptly instead of wedging the scoped thread's join.
+            send_receipt.wait();
+            assert!(no_receipt, "the regression must hit the pre-receipt window");
+            assert!(
+                authority_released,
+                "a late timeout must not retain an already-retired mount indefinitely"
+            );
+        });
+        receipt_rx.recv().expect("completion receipt");
+    }
