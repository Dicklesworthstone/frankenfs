+    #[test]
+    fn quarantine_holds_authority_until_dispatch_retires_bd_in31y() {
+        let _leases = QUARANTINED_MOUNT_LEASE_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let retirement = MountJoinRetirement::default();
+        let ops: Arc<dyn FsOps> = Arc::new(MinimalTestFs);
+        let weak = Arc::downgrade(&ops);
+        retirement.quarantine(ops);
+        let held_until_retirement = weak.strong_count();
+        retirement.retire();
+        assert_eq!(
+            held_until_retirement, 1,
+            "a timed-out worker must retain exactly one lease until actual retirement"
+        );
+        assert!(weak.upgrade().is_none());
+    }
+
+    #[test]
+    fn quarantine_repeated_timeouts_and_retirement_do_not_leak_bd_in31y() {
+        let _leases = QUARANTINED_MOUNT_LEASE_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let retirement = MountJoinRetirement::default();
+        let ops: Arc<dyn FsOps> = Arc::new(MinimalTestFs);
+        let weak = Arc::downgrade(&ops);
+        retirement.quarantine(Arc::clone(&ops));
+        retirement.quarantine(Arc::clone(&ops));
+        drop(ops);
+        let lease_count = weak.strong_count();
+        retirement.retire();
+        retirement.retire();
+        assert_eq!(
+            lease_count, 1,
+            "repeated timeouts must share the same lease"
+        );
+        assert!(weak.upgrade().is_none());
+
+        let after_retirement: Arc<dyn FsOps> = Arc::new(MinimalTestFs);
+        let after_retirement_weak = Arc::downgrade(&after_retirement);
+        retirement.quarantine(after_retirement);
+        assert!(
+            after_retirement_weak.upgrade().is_none(),
+            "a duplicate timeout cannot reactivate a retired mount"
+        );
+    }
