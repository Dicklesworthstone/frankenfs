+#[derive(Default)]
+enum MountJoinRetirementState {
+    #[default]
+    Joining,
+    Quarantined(u64),
+    Retired,
+}
+
+/// Serializes timeout-side lease publication with actual dispatch retirement.
+/// A completion receipt may still be in flight after the worker retires: a
+/// timeout in that window must not register a lease nobody can release.
+#[derive(Default)]
+struct MountJoinRetirement {
+    state: Mutex<MountJoinRetirementState>,
+}
+
+impl MountJoinRetirement {
+    fn quarantine(&self, ops: Arc<dyn FsOps>) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if matches!(*state, MountJoinRetirementState::Joining) {
+            *state = MountJoinRetirementState::Quarantined(register_quarantined_mount_lease(ops));
+        }
+    }
+
+    fn retire(&self) {
+        let previous = {
+            let mut state = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            std::mem::replace(&mut *state, MountJoinRetirementState::Retired)
+        };
+        if let MountJoinRetirementState::Quarantined(id) = previous {
+            release_quarantined_mount_lease(id);
+        }
+    }
 }
 
