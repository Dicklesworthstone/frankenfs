+#[test]
+fn ntfs_mapped_acl_open_checks_read_right_before_truncating_any_stream() {
+    let cx = Cx::for_testing();
+    let (dev, vol_bytes) = format_to_fault_device(
+        &cx, 16, 4096, NtfsFormatVersion::V3_0, 0xAC15_0002_0000_0001,
+    );
+    let mut engine = open_clean_engine(&cx, &dev, vol_bytes);
+    let root = engine.resolve_path_reference(&cx, "/").unwrap();
+    let (file, _) = engine.create_file_at(&cx, root, &utf16("write-only.bin"), b"base")
+        .into_result().unwrap();
+    engine.create_stream(&cx, file, &utf16("audit"), b"stream").into_result().unwrap();
+    engine.set_security_at(&cx, file, &stream_acl_descriptor(FILE_READ_DATA), DEFAULT_NTFS_FILETIME)
+        .into_result().unwrap();
+    let fs = NtfsFs::from_engine_with_policy(&cx, engine, stream_acl_policy(1002)).unwrap();
+    let mut scope = RequestScope::empty();
+    for name in ["write-only.bin", "write-only.bin:audit"] {
+        let attr = fs.lookup(&cx, &mut scope, InodeNumber(1), OsStr::new(name)).unwrap();
+        let before = dev.snapshot_live();
+        let writes = dev.write_bytes_total();
+        for flags in [
+            libc::O_RDONLY, libc::O_RDWR, libc::O_RDONLY | libc::O_TRUNC,
+            libc::O_RDWR | libc::O_TRUNC,
+        ] {
+            assert!(matches!(
+                fs.open(&cx, &mut scope, attr.ino, flags), Err(FfsError::PermissionDenied)
+            ), "read access must be checked for {name}, flags={flags}");
+        }
+        assert_eq!(dev.write_bytes_total(), writes);
+        assert_eq!(dev.snapshot_live(), before);
+        let (fh, _) = fs.open(&cx, &mut scope, attr.ino, libc::O_WRONLY).unwrap();
+        fs.write(&cx, &mut scope, attr.ino, 0, b"ok").unwrap();
+        assert!(matches!(fs.read(&cx, &mut scope, attr.ino, 0, 2), Err(FfsError::PermissionDenied)));
+        fs.release(&cx, &mut scope, ffs_core::vfs::ReleaseRequest {
+            ino: attr.ino, fh, flags: libc::O_WRONLY, lock_owner: None, flush: false,
+        }).unwrap();
+    }
+    fs.flush_on_destroy(&cx).unwrap();
+}
