+fn stream_acl_policy(caller_uid: u32) -> NtfsSidPolicy {
+    NtfsSidPolicy::Mapped {
+        caller_uid,
+        caller_gid: 2000,
+        map: NtfsSidMap {
+            enforce_acl: true,
+            posix_nfs_sids: true,
+            ..NtfsSidMap::default()
+        },
+    }
+}
+
+fn stream_acl_descriptor(denied: u32) -> Vec<u8> {
+    NtfsSecurityDescriptor {
+        resource_manager_control: 0,
+        control: SE_SELF_RELATIVE | SE_DACL_PRESENT,
+        owner: Some(NtfsSid {
+            authority: 5,
+            subauthorities: vec![88, 1, 1001],
+        }),
+        group: Some(NtfsSid {
+            authority: 5,
+            subauthorities: vec![88, 2, 2000],
+        }),
+        sacl: NtfsAcl {
+            present: false,
+            offset: 0,
+            revision: None,
+            ace_count: None,
+            size: None,
+            aces: Vec::new(),
+            padding: Vec::new(),
+        },
+        dacl: NtfsAcl {
+            present: true,
+            offset: 0,
+            revision: Some(2),
+            ace_count: Some(2),
+            size: None,
+            aces: vec![
+                build_simple_ace(
+                    ACE_TYPE_ACCESS_DENIED,
+                    0,
+                    denied,
+                    NtfsSid {
+                        authority: 5,
+                        subauthorities: vec![88, 1, 1002],
+                    },
+                ),
+                build_simple_ace(
+                    ACE_TYPE_ACCESS_ALLOWED,
+                    0,
+                    FILE_ALL_ACCESS,
+                    NtfsSid::world_everyone(),
+                ),
+            ],
+            padding: Vec::new(),
+        },
+    }
+    .encode()
+    .unwrap()
+}
+
+#[test]
+fn ntfs_mapped_acl_covers_named_stream_io_and_mutations() {
+    let cx = Cx::for_testing();
+    let (dev, vol_bytes) = format_to_fault_device(
+        &cx, 16, 4096, NtfsFormatVersion::V3_1, 0xAC15_0001_0000_0001,
+    );
+    let mut engine = open_clean_engine(&cx, &dev, vol_bytes);
+    let root = engine.resolve_path_reference(&cx, "/").unwrap();
+    let (file, _) = engine
+        .create_file_at(&cx, root, &utf16("restricted.bin"), b"base-content")
+        .into_result().unwrap();
+    engine.create_stream(&cx, file, &utf16("audit"), b"stream-content")
+        .into_result().unwrap();
+    engine.set_security_at(
+        &cx, file, &stream_acl_descriptor(FILE_READ_DATA | FILE_WRITE_DATA),
+        DEFAULT_NTFS_FILETIME,
+    ).into_result().unwrap();
+    let fs = NtfsFs::from_engine_with_policy(&cx, engine, stream_acl_policy(1002)).unwrap();
+    let mut scope = RequestScope::empty();
+    let root_ino = InodeNumber(1);
+    let base = fs.lookup(&cx, &mut scope, root_ino, OsStr::new("restricted.bin")).unwrap();
+    let ads = fs.lookup(&cx, &mut scope, root_ino, OsStr::new("restricted.bin:audit")).unwrap();
+    // The native SID-specific denial is not expressible by mode bits alone.
+    assert_ne!(ads.perm & 0o222, 0);
+    let before = dev.snapshot_live();
+    let writes = dev.write_bytes_total();
+    for ino in [base.ino, ads.ino] {
+        assert!(matches!(fs.read(&cx, &mut scope, ino, 0, 64), Err(FfsError::PermissionDenied)));
+        for flags in [libc::O_RDONLY, libc::O_WRONLY, libc::O_RDWR] {
+            assert!(matches!(fs.open(&cx, &mut scope, ino, flags), Err(FfsError::PermissionDenied)));
+        }
+        assert!(matches!(fs.open_read_only(&cx, ino, libc::O_RDONLY), Err(FfsError::PermissionDenied)));
+        assert!(matches!(fs.write(&cx, &mut scope, ino, 0, b"forbidden"), Err(FfsError::PermissionDenied)));
+        assert!(matches!(
+            fs.setattr(&cx, &mut scope, ino, &SetAttrRequest {
+                size: Some(0), ..SetAttrRequest::default()
+            }), Err(FfsError::PermissionDenied)
+        ));
+        assert!(matches!(fs.fallocate(&cx, &mut scope, ino, 0, 4, 0x03), Err(FfsError::PermissionDenied)));
+    }
+    assert!(matches!(
+        fs.create(&cx, &mut scope, root_ino, OsStr::new("restricted.bin:new"), 0o666, 1002, 2000),
+        Err(FfsError::PermissionDenied)
+    ));
+    assert!(matches!(
+        fs.unlink(&cx, &mut scope, root_ino, OsStr::new("restricted.bin:audit")),
+        Err(FfsError::PermissionDenied)
+    ));
+    assert!(matches!(
+        fs.rename(&cx, &mut scope, root_ino, OsStr::new("restricted.bin:audit"),
+            root_ino, OsStr::new("restricted.bin:moved")),
+        Err(FfsError::PermissionDenied)
+    ));
+    assert_eq!(dev.write_bytes_total(), writes);
+    assert_eq!(dev.snapshot_live(), before);
+    assert!(fs.last_durable_token().unwrap().is_none());
+    drop(fs);
+
+    // Another SID retains authorized access to the exact same native streams.
+    let engine = open_clean_engine(&cx, &dev, vol_bytes);
+    let fs = NtfsFs::from_engine_with_policy(&cx, engine, stream_acl_policy(1001)).unwrap();
+    let ads = fs.lookup(&cx, &mut scope, root_ino, OsStr::new("restricted.bin:audit")).unwrap();
+    assert_eq!(fs.read(&cx, &mut scope, ads.ino, 0, 64).unwrap(), b"stream-content");
+    let (fh, _) = fs.open(&cx, &mut scope, ads.ino, libc::O_RDWR).unwrap();
+    fs.write(&cx, &mut scope, ads.ino, 0, b"allowed").unwrap();
+    fs.setattr(&cx, &mut scope, ads.ino, &SetAttrRequest {
+        size: Some(7), ..SetAttrRequest::default()
+    }).unwrap();
+    fs.fallocate(&cx, &mut scope, ads.ino, 1, 3, 0x03).unwrap();
+    assert_eq!(fs.read(&cx, &mut scope, ads.ino, 0, 64).unwrap(), b"a\0\0\0wed");
+    assert_eq!(fs.read(&cx, &mut scope, base.ino, 0, 64).unwrap(), b"base-content");
+    fs.release(&cx, &mut scope, ffs_core::vfs::ReleaseRequest {
+        ino: ads.ino, fh, flags: libc::O_RDWR, lock_owner: None, flush: false,
+    }).unwrap();
+    fs.flush_on_destroy(&cx).unwrap();
+}
