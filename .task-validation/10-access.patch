+fn stream_acl_policy(caller_uid: u32) -> NtfsSidPolicy {
+    NtfsSidPolicy::Mapped {
+        caller_uid,
+        caller_gid: 2000,
+        map: NtfsSidMap {
+            enforce_acl: true,
+            posix_nfs_sids: true,
+            ..NtfsSidMap::default()
+        },
+    }
+}
+
+fn stream_acl_descriptor(denied: u32) -> Vec<u8> {
+    NtfsSecurityDescriptor {
+        resource_manager_control: 0,
+        control: SE_SELF_RELATIVE | SE_DACL_PRESENT,
+        owner: Some(NtfsSid {
+            authority: 5,
+            subauthorities: vec![88, 1, 1001],
+        }),
+        group: Some(NtfsSid {
+            authority: 5,
+            subauthorities: vec![88, 2, 2000],
+        }),
+        sacl: NtfsAcl {
+            present: false,
+            offset: 0,
+            revision: None,
+            ace_count: None,
+            size: None,
+            aces: Vec::new(),
+            padding: Vec::new(),
+        },
+        dacl: NtfsAcl {
+            present: true,
+            offset: 0,
+            revision: Some(2),
+            ace_count: Some(2),
+            size: None,
+            aces: vec![
+                build_simple_ace(
+                    ACE_TYPE_ACCESS_DENIED,
+                    0,
+                    denied,
+                    NtfsSid {
+                        authority: 5,
+                        subauthorities: vec![88, 1, 1002],
+                    },
+                ),
+                build_simple_ace(
+                    ACE_TYPE_ACCESS_ALLOWED,
+                    0,
+                    FILE_ALL_ACCESS,
+                    NtfsSid::world_everyone(),
+                ),
+            ],
+            padding: Vec::new(),
+        },
+    }
+    .encode()
+    .unwrap()
+}
