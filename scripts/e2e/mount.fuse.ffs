#!/usr/bin/env bash
# mount(8) helper for `mount -t fuse.ffs <image> <dir> [-o opts]`.
#
# Installed as /sbin/mount.fuse.ffs it lets tools that mount through mount(8)
# drive FrankenFS; xfstests does so with FSTYP=fuse FUSE_SUBTYP=.ffs, passing
# TEST_DEV/SCRATCH_DEV (image paths) as the source. The image path is also the
# FUSE fsname, so /proc/mounts shows it as the mount source, which is how
# xfstests recognises an already-mounted device.
#
# Env: FFS_CLI_BIN (default /usr/local/bin/ffs-cli), FFS_MOUNT_LOG_DIR
# (default /tmp) for the daemon's log, one file per mountpoint,
# FFS_FUSE_SUBTYPE (unset: `ffs`, mount type `fuse.ffs`).
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "usage: mount.fuse.ffs <image> <mountpoint> [-o options]" >&2
    exit 1
fi
image=$1
dir=$2
shift 2
opts=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -o) opts=$2; shift 2 ;;
        *) shift ;;
    esac
done

# A remount changes flags on the live mount; starting a second daemon would
# stack a fresh read-write mount on top (xfstests generic/306's remount,ro
# then let a create succeed). The kernel handles it: FUSE accepts
# MS_REMOUNT|MS_RDONLY, after which the VFS refuses writes with EROFS.
# `-i` keeps mount(8) from calling this helper again.
if [[ ,$opts, == *,remount,* ]]; then
    exec mount -i -o "$opts" "$dir"
fi

args=(mount --rw --fsname "$image")
IFS=, read -ra parts <<<"$opts"
for part in "${parts[@]}"; do
    case $part in
        ro) args=(mount --fsname "$image") ;;
    esac
done
atime=""
# A filesystem root mounts through mount(8) is for every user, with access
# decided by permission bits (the mount uses default_permissions), like any
# kernel filesystem. Without allow_other, fuser answers other users itself
# with EACCES (xfstests generic/087's owner utime ran as uid 99 and failed).
allow_other=""
[[ $EUID -eq 0 ]] && allow_other=yes
# mount(8) by root defaults to dev,suid, as for a kernel filesystem; FUSE
# defaults to nodev,nosuid, which made device nodes on the mount unopenable
# (xfstests generic/184: EACCES). -o nodev / -o nosuid opt out.
dev=""
suid=""
if [[ $EUID -eq 0 ]]; then
    dev=yes
    suid=yes
fi
for part in "${parts[@]}"; do
    case $part in
        allow_other) allow_other=yes ;;
        # FUSE inodes are S_NOATIME, so the daemon applies the atime policy.
        noatime | relatime | strictatime) atime=$part ;;
        dev) dev=yes ;;
        nodev) dev="" ;;
        suid) suid=yes ;;
        nosuid) suid="" ;;
    esac
done
[[ -n $allow_other ]] && args+=(--allow-other)
[[ -n $dev ]] && args+=(--dev)
[[ -n $suid ]] && args+=(--suid)
[[ -n $atime ]] && args+=(--atime "$atime")
# An empty FFS_FUSE_SUBTYPE mounts with no subtype, so the kernel reports the
# type as plain `fuse` (xfstests FSTYP=fuse compares against that).
if [[ -n ${FFS_FUSE_SUBTYPE+set} ]]; then
    args+=(--subtype "$FFS_FUSE_SUBTYPE")
fi

bin=${FFS_CLI_BIN:-/usr/local/bin/ffs-cli}
log="${FFS_MOUNT_LOG_DIR:-/tmp}/ffs-mount-$(basename "$dir").log"
echo "== $(date -u +%FT%TZ) $bin ${args[*]} $image $dir" >>"$log"
# The daemon IS the filesystem, so it must outlive whoever ran mount(8).
# setsid leaves the caller's session but not its cgroup, and stopping a
# cgroup kills every process in it: xfstests runs each test in a systemd
# scope and stops it afterwards, so a daemon started by a test's own
# _test_mount died with the test, leaving a dead mount (ENOTCONN) that broke
# the next test. Under systemd, root's daemon gets a transient scope of its
# own.
launch=(setsid)
if [[ $EUID -eq 0 && -d /run/systemd/system ]] && command -v systemd-run >/dev/null; then
    launch=(systemd-run --quiet --scope --collect
        --unit "ffs-mount-$(basename "$dir")-$$" setsid)
fi
"${launch[@]}" "$bin" "${args[@]}" "$image" "$dir" >>"$log" 2>&1 </dev/null &
pid=$!

# mount(8) must not return before the mount is live.
for _ in $(seq 1 600); do
    if findmnt -rn --mountpoint "$dir" >/dev/null 2>&1; then
        exit 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "mount.fuse.ffs: ffs-cli exited before mounting $dir (log: $log)" >&2
        tail -n 20 "$log" >&2
        exit 1
    fi
    sleep 0.1
done
echo "mount.fuse.ffs: timed out waiting for $dir (log: $log)" >&2
exit 1
